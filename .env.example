# Copy to .env. Never commit real credentials.
WIFI_SSID=your-wifi-name
WIFI_PASSWORD=your-wifi-password
AIMP_HOST=your-aimp-host.local
AIMP_PORT=19371
AIMP_PASSWORD=your-monkeymote-password
# auto prefers microSD and falls back to internal flash; sd requires a card;
# flash is useful for qualifying the compact no-card fallback.
PLAYLIST_STORAGE=auto

